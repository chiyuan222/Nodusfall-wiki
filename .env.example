DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nodusfall?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
PORT=4000

# 邮箱验证码 SMTP（腾讯企业邮 / QQ 邮箱 / 163 等）
# 未配置 SMTP_HOST 时，开发模式把验证码写入 apps/api/.dev/email-codes.log 便于联调；
# 上线前必须配置以下项，否则用户收不到验证码邮件。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
