generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  WIKI_EDITOR
  GUIDE_EDITOR
  VIDEO_EDITOR
  WIKI_MODERATOR
  GUIDE_MODERATOR
  FORUM_MODERATOR
  VIDEO_MODERATOR
  ADMIN
  OWNER
}

enum UserGroup {
  NORMAL
  VERIFIED
  PREMIUM
}

enum UserStatus {
  ACTIVE
  MUTED
  BANNED
  DELETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CommentTargetType {
  WIKI_PAGE
  GUIDE
}

model User {
  id           String   @id @default(uuid())
  siteId       Int      @unique @default(autoincrement())
  email        String?  @unique
  phone        String?  @unique
  username     String   @unique
  passwordHash String
  displayName  String?
  avatarUrl    String?
  bio          String?
  role         UserRole @default(MEMBER)
  status       UserStatus @default(ACTIVE)
  group        UserGroup @default(NORMAL)
  level        Int       @default(1)
  exp          Int       @default(0)
  permissions  String[]
  wikiCreateGranted Boolean @default(false)
  guideCreateGranted Boolean @default(false)
  videoShareGranted  Boolean @default(false)
  showThreads   Boolean @default(true)
  showComments  Boolean @default(true)
  showBookmarks Boolean @default(true)
  banReason    String?
  banUntil     DateTime?
  mutedUntil   DateTime?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  history       BrowseHistory[]
  wikiPageLikes WikiPageLike[] @relation("WikiPageLikeUser")
  wikiPageDislikes WikiPageDislike[] @relation("WikiPageDislikeUser")
  wikiPageBookmarks WikiPageBookmark[] @relation("WikiPageBookmarkUser")
  guideLikes    GuideLike[]    @relation("GuideLikeUser")
  guideDislikes GuideDislike[] @relation("GuideDislikeUser")
  guideBookmarks GuideBookmark[] @relation("GuideBookmarkUser")
  threadLikes   ForumThreadLike[] @relation("ThreadLikeUser")
  sentMessages  DirectMessage[]   @relation("DirectMessageSender")
  receivedMessages DirectMessage[] @relation("DirectMessageRecipient")
  announcements Announcement[]    @relation("AnnouncementAuthor")
  checkins     CheckIn[]
  expLogs      ExpLog[]
  wikiPages     WikiPage[]        @relation("WikiPageAuthor")
  wikiRevisions WikiPageRevision[] @relation("WikiRevisionAuthor")
  guides        Guide[]           @relation("GuideAuthor")
  ratings       Rating[]          @relation("RatingUser")
  threads       ForumThread[]     @relation("ThreadAuthor")
  posts         ForumPost[]       @relation("PostAuthor")
  comments      Comment[]         @relation("CommentAuthor")
  reports       Report[]          @relation("ReportReporter")
  handledReports Report[]         @relation("ReportHandler")
  feedbacks      Feedback[]       @relation("FeedbackAuthor")
  handledFeedback Feedback[]      @relation("FeedbackHandler")
  videoEntries   VideoEntry[]     @relation("VideoAuthor")
  uploads       Upload[]          @relation("UploadUser")
  postLikes     ForumPostLike[]   @relation("PostLikeUser")
  bookmarks     ForumThreadBookmark[] @relation("ThreadBookmarkUser")
  commentLikes  CommentLike[]     @relation("CommentLikeUser")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  lastActiveAt     DateTime?
  createdAt        DateTime  @default(now())
}

model EmailCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model BrowseHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  kind       String
  slug       String
  title      String
  boardSlug  String?
  coverImage String?
  excerpt    String?
  viewedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, kind, slug])
  @@index([userId, viewedAt])
}

model WikiCategory {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  sortOrder   Int         @default(0)
  pages       WikiPage[]
}

model WikiPage {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  content     String
  excerpt     String
  coverImage  String?
  featuredAt  DateTime?
  viewCount   Int         @default(0)
  likeCount   Int         @default(0)
  dislikeCount Int        @default(0)
  categoryId  String
  category    WikiCategory  @relation(fields: [categoryId], references: [id])
  tags        String[]
  status      ContentStatus @default(DRAFT)
  version     Int           @default(1)
  authorId    String
  author      User          @relation("WikiPageAuthor", fields: [authorId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  revisions   WikiPageRevision[]
  likes       WikiPageLike[]
  bookmarks   WikiPageBookmark[]
  dislikes    WikiPageDislike[]
}

model WikiPageLike {
  id        String   @id @default(uuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("WikiPageLikeUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([pageId, userId])
}

model WikiPageBookmark {
  id        String   @id @default(uuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("WikiPageBookmarkUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([pageId, userId])
}

model WikiPageDislike {
  id        String   @id @default(uuid())
  pageId    String
  page      WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("WikiPageDislikeUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([pageId, userId])
}

model WikiPageRevision {
  id        String    @id @default(uuid())
  pageId    String
  page      WikiPage  @relation(fields: [pageId], references: [id])
  version   Int
  title     String
  content   String
  changelog String?
  authorId  String
  author    User      @relation("WikiRevisionAuthor", fields: [authorId], references: [id])
  createdAt DateTime  @default(now())
}

model Guide {
  id               String        @id @default(uuid())
  slug             String        @unique
  title            String
  content          String
  excerpt          String
  coverImage       String?
  featuredAt       DateTime?
  viewCount        Int         @default(0)
  likeCount        Int         @default(0)
  dislikeCount     Int         @default(0)
  categoryId       String?
  category         GuideCategory? @relation(fields: [categoryId], references: [id])
  tags             String[]
  status           ContentStatus @default(DRAFT)
  relatedCharacter String?
  ratingAvg        Float         @default(0)
  ratingCount      Int           @default(0)
  authorId         String
  author           User          @relation("GuideAuthor", fields: [authorId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  ratings          Rating[]
  likes            GuideLike[]
  bookmarks        GuideBookmark[]
  dislikes         GuideDislike[]

  @@index([categoryId])
}

model GuideCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guides      Guide[]
}

model GuideLike {
  id        String @id @default(uuid())
  guideId   String
  guide     Guide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation("GuideLikeUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([guideId, userId])
}

model GuideBookmark {
  id        String @id @default(uuid())
  guideId   String
  guide     Guide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation("GuideBookmarkUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([guideId, userId])
}

model GuideDislike {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("GuideDislikeUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([guideId, userId])
}

model Rating {
  id        String   @id @default(uuid())
  guideId   String
  guide     Guide    @relation(fields: [guideId], references: [id])
  userId    String
  user      User     @relation("RatingUser", fields: [userId], references: [id])
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guideId, userId])
}

model ForumBoard {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  description String?
  sortOrder   Int           @default(0)
  threads     ForumThread[]
}

model ForumThread {
  id          String     @id @default(uuid())
  boardId     String
  board       ForumBoard @relation(fields: [boardId], references: [id])
  title       String
  content     String
  coverImage  String?
  featuredAt  DateTime?
  authorId    String
  author      User       @relation("ThreadAuthor", fields: [authorId], references: [id])
  pinned      Boolean    @default(false)
  locked      Boolean    @default(false)
  replyCount  Int        @default(0)
  likeCount   Int        @default(0)
  viewCount   Int        @default(0)
  lastPostAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       ForumPost[]
  bookmarks   ForumThreadBookmark[]
  likes       ForumThreadLike[]
}

model ForumThreadLike {
  id        String       @id @default(uuid())
  threadId  String
  thread    ForumThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("ThreadLikeUser", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([threadId, userId])
}

model ForumPost {
  id        String       @id @default(uuid())
  threadId  String
  thread    ForumThread  @relation(fields: [threadId], references: [id])
  authorId  String
  author    User         @relation("PostAuthor", fields: [authorId], references: [id])
  content   String
  floor     Int
  likeCount Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  likes     ForumPostLike[]
}

model ForumPostLike {
  id        String     @id @default(uuid())
  postId    String
  post      ForumPost  @relation(fields: [postId], references: [id])
  userId    String
  user      User       @relation("PostLikeUser", fields: [userId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
}

model ForumThreadBookmark {
  id        String      @id @default(uuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id])
  userId    String
  user      User        @relation("ThreadBookmarkUser", fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([threadId, userId])
}

model Comment {
  id         String            @id @default(uuid())
  targetType CommentTargetType
  targetId   String
  parentId   String?
  parent     Comment?          @relation("CommentParent", fields: [parentId], references: [id], onDelete: Cascade)
  authorId   String
  author     User              @relation("CommentAuthor", fields: [authorId], references: [id])
  content    String
  likeCount  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  likes      CommentLike[]
  replies    Comment[]         @relation("CommentParent")

  @@index([parentId, createdAt])
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id])
  userId    String
  user      User     @relation("CommentLikeUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model Upload {
  id        String   @id @default(uuid())
  url       String
  key       String
  mimeType  String
  size      Int
  userId    String
  user      User     @relation("UploadUser", fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model ContentPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model DailyStat {
  id        String   @id @default(uuid())
  date      DateTime @unique
  pv        Int      @default(0)
  uv        Int      @default(0)
  dau       Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DailyActiveUser {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("DirectMessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("DirectMessageRecipient", fields: [recipientId], references: [id])
  content     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt])
  @@index([senderId])
}

model Announcement {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  title     String
  content   String
  createdAt DateTime @default(now())
  reads     AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
}

model VideoEntry {
  id          String   @id @default(uuid())
  kind        String
  title       String
  url         String
  platform    String
  coverImage  String?
  description String?
  authorId    String?
  author      User?    @relation("VideoAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([kind, published, sortOrder])
}

model SiteConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  streak    Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model ExpLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, reason, createdAt])
}

model SmsCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorName  String
  action     String
  targetType String?
  targetId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model SensitiveWord {
  id        String   @id @default(uuid())
  word      String   @unique
  createdAt DateTime @default(now())
}

model Report {
  id          String    @id @default(uuid())
  reporterId  String
  reporter    User      @relation("ReportReporter", fields: [reporterId], references: [id])
  targetType  String
  targetId    String
  reason      String
  detail      String?
  status      String    @default("PENDING")
  note        String?
  handledById String?
  handledBy   User?     @relation("ReportHandler", fields: [handledById], references: [id])
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  APPEAL
  OTHER
}

enum FeedbackStatus {
  PENDING
  REPLIED
  CLOSED
}

model Feedback {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  category    FeedbackCategory
  content     String
  status      FeedbackStatus   @default(PENDING)
  replyText   String?
  repliedById String?
  repliedBy   User?            @relation("FeedbackHandler", fields: [repliedById], references: [id])
  repliedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
